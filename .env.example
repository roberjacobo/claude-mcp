# Copy this file to `.env` and fill in your values.
#   cp .env.example .env        (Linux / Mac / WSL)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)

# ---------------------------------------------------------------------------
# MODEL CONFIGURATION
# ---------------------------------------------------------------------------
# Any model from https://huggingface.co/sentence-transformers works.
# Default is small and fast; swap for a stronger English model if desired
# (e.g. BAAI/bge-base-en-v1.5, intfloat/e5-base-v2).
# IMPORTANT: changing the model invalidates existing embeddings.
# Run `make clean-all` and re-ingest after switching.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# DATA SOURCE
# ---------------------------------------------------------------------------
# Absolute path to the folder containing the documents to index.
# Works with any local folder, including synced cloud folders
# (OneDrive, Google Drive, Dropbox, iCloud, etc.).
#
# Examples by platform:
#   Windows (native):  C:\Users\YourUser\Documents
#   Windows (native):  C:/Users/YourUser/Documents          (forward slashes also work)
#   WSL2:              /mnt/c/Users/YourUser/Documents
#   macOS:             /Users/YourUser/Documents
#   Linux:             /home/youruser/documents
#
# On Windows, do NOT wrap the path in quotes.
DATA_PATH=C:\Users\YourUser\Documents
